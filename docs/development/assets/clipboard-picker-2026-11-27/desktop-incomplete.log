echo "cmd-rc $rc";
printf '%s\n' "$cmd_out" | sed 's/^/cmd-out /';
[ "$rc" -ne 0 ] && printf '%s\n' "$(cat "$tmp/cmd.err")" | sed 's/^/cmd-err /';
