echo "opencode-working $oc_rss";
cfg_after=$(sha256sum "$h/.config/opencode/opencode.json" | awk '{print $1}');
if [ "$cfg_before" = "$cfg_after" ]; then echo "config-unchanged yes"; else echo "config-unchanged no"; fi;
trap - EXIT;
cleanup;
