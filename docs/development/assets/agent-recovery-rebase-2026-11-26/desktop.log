          "description": "Long command to be stopped"
        }
      },
      "after_tool": "Should not finish"
    },
    {
      "match": "denied-cmd",
      "tool_call": {
        "name": "shell",
        "arguments": {
          "command": "echo DENIED_$((40 + 2))",
