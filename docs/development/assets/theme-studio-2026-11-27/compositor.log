import fcntl, os, struct, time
fd = os.open('/dev/uinput', os.O_WRONLY)
fcntl.ioctl(fd, 0x40045564, 1)  # UI_SET_EVBIT EV_KEY
fcntl.ioctl(fd, 0x40045565, 30)  # UI_SET_KEYBIT KEY_A
fcntl.ioctl(fd, 0x405c5503, struct.pack('HHHH80sI', 3, 1, 1, 1, b'crowbar-second-keyboard', 0))
fcntl.ioctl(fd, 0x5501)  # UI_DEV_CREATE
while not os.path.exists('/tmp/unplug'):
    time.sleep(0.1)
fcntl.ioctl(fd, 0x5502)  # UI_DEV_DESTROY
EOF
