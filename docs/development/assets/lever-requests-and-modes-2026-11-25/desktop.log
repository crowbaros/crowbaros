import socket, struct, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(3)
def recv_exact(n):
    buf = b""
    while len(buf) < n and (more := s.recv(n - len(buf))):
        buf += more
    return buf
try:
    s.connect(sys.argv[1])
    vframe = bytes.fromhex(sys.argv[2])
    s.sendall(vframe)
    vreply = recv_exact(len(vframe))
    if not vreply:
        print("refused")
        sys.exit(0)
    s.sendall(bytes.fromhex(sys.argv[3]))
    hdr = recv_exact(4)
    if len(hdr) < 4:
        print("short")
        sys.exit(0)
    (length,) = struct.unpack(">I", hdr)
    body = recv_exact(length)
    print("ok", vreply.hex(), body.decode())
except (ConnectionResetError, BrokenPipeError):
    print("refused")
except OSError as error:
    print("error:", error.strerror or error)
