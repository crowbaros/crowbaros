+// CrowbarOS: a frame may contain Axis without the optional AxisSource or
+// discrete events. Keep those continuous pixels as the fallback, and never
+// add them to the wheel representation of the same movement.
+use crate::{Pixels, Point, ScrollDelta};
+
+pub(super) fn scroll_delta(
+    continuous: Option<Point<Pixels>>,
+    discrete: Option<Point<f32>>,
+) -> Option<ScrollDelta> {
+    discrete
+        .map(ScrollDelta::Lines)
+        .or_else(|| continuous.map(ScrollDelta::Pixels))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{point, px};
+
+    #[test]
+    fn bare_axis_and_touchpad_frames_keep_continuous_pixels() {
+        let expected = point(px(-90.0), px(240.0));
+        let Some(ScrollDelta::Pixels(delta)) = scroll_delta(Some(expected), None) else {
+            panic!("Axis + Frame must work without AxisSource or discrete events");
+        };
+        assert_eq!(delta, expected);
+    }
+
+    #[test]
+    fn wheel_discrete_takes_precedence_without_adding_continuous_movement() {
+        let pixels = point(px(0.0), px(-45.0));
+        let lines = point(0.0, -3.0);
+        let Some(ScrollDelta::Lines(delta)) = scroll_delta(Some(pixels), Some(lines)) else {
+            panic!("a wheel frame must keep its line units");
+        };
+        assert_eq!(delta, lines);
+    }
+
+    #[test]
+    fn high_resolution_wheel_keeps_fractional_lines() {
+        let pixels = point(px(4.0), px(-8.0));
+        let lines = point(0.25, -0.5);
+        let Some(ScrollDelta::Lines(delta)) = scroll_delta(Some(pixels), Some(lines)) else {
+            panic!("value120 must not be rounded to complete steps");
+        };
+        assert_eq!(delta, lines);
+    }
+
+    #[test]
+    fn each_frame_selects_only_its_own_events() {
+        let mut continuous = Some(point(px(0.0), px(-60.0)));
+        let mut discrete = Some(point(0.0, -3.0));
+        assert!(matches!(
+            scroll_delta(continuous.take(), discrete.take()),
+            Some(ScrollDelta::Lines(_))
+        ));
+        assert!(scroll_delta(continuous.take(), discrete.take()).is_none());
+        // A later bare frame cannot inherit the previous wheel's source or
+        // line representation. It is its own continuous motion.
+        continuous = Some(point(px(7.0), px(0.0)));
+        assert!(matches!(
+            scroll_delta(continuous.take(), discrete.take()),
+            Some(ScrollDelta::Pixels(_))
+        ));
+        assert!(scroll_delta(None, Some(point(0.0, 0.0))).is_some());
+    }
+}
