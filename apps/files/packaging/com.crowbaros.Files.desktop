[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and organize folders and files
Exec=crowbaros-files %u
Icon=com.crowbaros.Files
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=Files;Folder;Directory;Browse;Manager;CrowbarOS;
StartupWMClass=com.crowbaros.Files
