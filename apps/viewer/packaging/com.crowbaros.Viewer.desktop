[Desktop Entry]
Type=Application
Name=Viewer
Comment=View images and PDF documents
Exec=crowbaros-viewer %f
Icon=image-x-generic
StartupWMClass=com.crowbaros.Viewer
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/tiff;image/svg+xml;application/pdf;
