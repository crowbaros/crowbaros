#!/bin/sh
# Lever's service (ADR 0036). It starts at boot, whether or not anyone has
# unlocked, and waits for nothing. runit starts it again whenever it exits:
# at once, or a second later when it had run for less than a second.
# Root makes what the person cannot: their runtime directory, and the
# directory of the surface socket, which is the person's so Lever can bind
# there, and which only the shell's group may enter besides. A socket made
# there takes the shell's group. Lever checks the shell's user ID with
# SO_PEERCRED as well. Lever runs as the person, with their groups, in the
# environment the launcher gives an app, starting in their home. Its state
# (database and log) is in the person's home, and the person socket is in
# their runtime directory, both readable by the person alone.
set -eu
exec >>/var/log/crowbar-lever.log 2>&1
PERSON_UID=1003
PERSON=$(getent passwd "$PERSON_UID" | cut -d: -f1)
test -n "$PERSON" || { echo "no account has user ID $PERSON_UID"; exit 1; }
PERSON_HOME=$(getent passwd "$PERSON_UID" | cut -d: -f6)
SHELL_UID=$(id -u crowbar-shell)
# This file holds what this script and Lever's process print, never Lever's
# own log. It is the person's alone all the same.
chown "$PERSON:$PERSON" /var/log/crowbar-lever.log
chmod 0600 /var/log/crowbar-lever.log
install -d -o "$PERSON" -g "$PERSON" -m 0700 "/run/user/$PERSON_UID"
install -d -o "$PERSON" -g crowbar-shell -m 2750 /run/crowbar-lever
# chpst gives the person's own group alone unless it is told the rest.
exec chpst -u "$PERSON:$(id -Gn "$PERSON" | tr ' ' ':')" \
  /usr/local/bin/crowbar-launcher as-app \
  /usr/local/bin/crowbar-lever \
  --state "$PERSON_HOME/.local/state/crowbaros/lever" \
  --surface-socket /run/crowbar-lever/surface --shell-uid "$SHELL_UID" \
  --person-socket "/run/user/$PERSON_UID/crowbar-lever/person" --person-uid "$PERSON_UID"
