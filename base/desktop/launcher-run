#!/bin/sh
# The launcher service. Root makes what the person cannot: their runtime
# directory, with the compositor's socket for apps linked into it as
# `wayland-0`, and the launch socket's directory, which root owns and only the
# shell's group may enter. The launcher binds its socket there and then
# becomes the person, so the apps it starts are the person's.
set -eu
exec >>/var/log/crowbar-launcher.log 2>&1
PERSON_UID=1003
PERSON=$(getent passwd "$PERSON_UID" | cut -d: -f1)
test -n "$PERSON" || { echo "no account has user ID $PERSON_UID"; exit 1; }
install -d -o "$PERSON" -g "$PERSON" -m 0700 "/run/user/$PERSON_UID"
ln -sfn /run/crowbar-apps/wayland-0 "/run/user/$PERSON_UID/wayland-0"
install -d -o root -g crowbar-shell -m 0750 /run/crowbar-launch
touch /var/log/crowbar-apps.log
chown "$PERSON:$PERSON" /var/log/crowbar-apps.log
exec /usr/local/bin/crowbar-launcher
