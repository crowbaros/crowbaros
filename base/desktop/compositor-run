#!/bin/sh
set -eu
exec >>/var/log/crowbar-compositor.log 2>&1
# The shell reaches the compositor's Wayland socket and its control channel in
# a directory only the compositor and the shell's group can enter, and the
# person's apps reach theirs in one only the compositor and the person's group
# can. The compositor accepts each by the peer's user ID as well (ADR 0032),
# and the launcher links the apps' socket into the person's runtime directory
# as `wayland-0`. The
# unlock helper, as root, reaches the compositor's unlock socket in a
# directory no one else can enter; once it listens, only the helper's word
# unlocks, and the session starts locked (Fulcrum's proposal).
install -d -m 0755 /run/crowbar-trusted
install -d -o crowbar-compositor -g crowbar-shell -m 2750 /run/crowbar-trusted/compositor
PERSON_UID=1003
PERSON_GID=$(getent passwd "$PERSON_UID" | cut -d: -f4)
test -n "$PERSON_GID" || exit 1
install -d -o crowbar-compositor -g "$PERSON_GID" -m 2750 /run/crowbar-person
install -d -o crowbar-compositor -g root -m 0700 /run/crowbar-trusted/unlock
chown crowbar-compositor:crowbar-compositor /var/log/crowbar-compositor.log
chown crowbar-compositor:crowbar-compositor /home/crowbar-compositor
test -S /run/seatd.sock || exit 1
exec openvt -c 2 -s -f -w -- chpst -u crowbar-compositor:crowbar-compositor:_seatd env -i \
  HOME=/home/crowbar-compositor PATH=/usr/local/bin:/usr/bin:/bin FULCRUM_LOG=info \
  XCURSOR_THEME=Vanilla-DMZ XCURSOR_SIZE=24 \
  sh -c 'exec crowbar-compositor --backend tty \
  --shell-socket /run/crowbar-trusted/compositor/wayland --shell-uid 1001 \
  --shell-control-socket /run/crowbar-trusted/compositor/control \
  --apps-socket /run/crowbar-person/wayland-0 --apps-uid 1003 \
  --unlock-socket /run/crowbar-trusted/unlock/compositor --unlock-uid 0 \
  --layout /home/crowbar-compositor/layout \
  --start-locked \
  >>/var/log/crowbar-compositor.log 2>&1'
